{
  "name": "astro-ph-researcher",
  "version": "3.3.0",
  "description": "astro-ph-researcher v3.3：DSH/Codex 天文工作台；新增 PPT 桥、新手循序教程、深度/交叉学科盲点扫描、主题/本地背景、研究计划树、输入框应用与 Skill 选择、交接弹窗；保留 34 方法、推荐书籍、写作/评分/作者确认、书目与格式。",
  "author": "天外奇航 (@hyperskysail) <1253932197@qq.com>",
  "contributors": [
    "天外奇航 (@hyperskysail, GXU-CN)"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "data",
    "skills",
    "codex",
    "presentation",
    "demo",
    "assets",
    "screenshots.json",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "AUTHORS.md",
    "CITATION.cff",
    "CHANGELOG.md",
    "LICENSE",
    "SUPPORT.md",
    "RELEASE_NOTES.md",
    "ACKNOWLEDGMENTS.md",
    "SECURITY.md",
    "PRIVACY.md",
    "DISCLAIMER.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/dictionary.mjs && node test/references.mjs && node test/writing.mjs && node test/skills.mjs && node test/data-library.mjs && node test/thesis-fetcher.mjs && node test/migration.mjs && node test/formula-ui.mjs && node test/v2.mjs && node test/host-smoke.mjs && node test/client-smoke.mjs",
    "test:live": "node scripts/live-check.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "check:client": "node --check lib/client.js",
    "check": "node --check lib/index.js && node --check lib/client.js && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "astronomy",
    "astrophysics",
    "astronomy",
    "astrophysics",
    "glossary",
    "literature",
    "writing",
    "skills",
    "codex",
    "openalex",
    "ads",
    "cnki"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT",
  "funding": {
    "type": "custom",
